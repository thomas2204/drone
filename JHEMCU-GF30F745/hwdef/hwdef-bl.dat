# JHEMCU GF30F745 custom ArduPilot bootloader

MCU STM32F7xx STM32F745xx

APJ_BOARD_ID 1050

OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 1024

FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 96

# USB bootloader
SERIAL_ORDER OTG1

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# SWD
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# Keep peripheral CS pins inactive during boot
PE4 MPU6000_CS CS
PA4 FLASH_CS CS
PB12 AT7456E_CS CS

# Board LED
PA2 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 0
