# JHEMCU GF30F745
# Initial custom ArduPilot hardware definition
# Derived from verified Betaflight JHEMCUF745 resources

MCU STM32F7xx STM32F745xx

# Temporary custom board ID for local development
APJ_BOARD_ID 1050

OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 1024

# ArduPilot bootloader occupies first 96KB
FLASH_RESERVE_START_KB 96

define HAL_STORAGE_SIZE 16384
define STORAGE_FLASH_PAGE 1



# -------------------------------------------------
# USB
# -------------------------------------------------

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# SWD debugging
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD


# -------------------------------------------------
# SPI1 - 16MB external flash
# -------------------------------------------------

PA4 FLASH_CS CS
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1


# -------------------------------------------------
# SPI2 - AT7456E OSD
# -------------------------------------------------

PB12 AT7456E_CS CS
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2


# -------------------------------------------------
# SPI4 - ICM42688-P
# -------------------------------------------------

PE4 MPU6000_CS CS
PE2 SPI4_SCK SPI4
PE5 SPI4_MISO SPI4
PE6 SPI4_MOSI SPI4


# -------------------------------------------------
# I2C1 - external sensors
# -------------------------------------------------

I2C_ORDER I2C1

PB6 I2C1_SCL I2C1 PULLUP
PB7 I2C1_SDA I2C1 PULLUP


# -------------------------------------------------
# Serial ports
#
# SERIAL0 = USB
# SERIAL1 = UART1
# SERIAL2 = UART2  <-- ELRS / CRSF
# SERIAL3 = UART3
# SERIAL4 = UART4
# SERIAL5 = UART5
# SERIAL6 = UART6
# SERIAL7 = UART7
# -------------------------------------------------

SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 UART5 USART6 UART7

# UART1
PA9  USART1_TX USART1
PA10 USART1_RX USART1 NODMA

# UART2 - ELRS
PD5 USART2_TX USART2
PD6 USART2_RX USART2 NODMA
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_RCIN

# UART3
PB10 USART3_TX USART3
PB11 USART3_RX USART3

# UART4
PA0 UART4_TX UART4
PA1 UART4_RX UART4 NODMA

# UART5
PC12 UART5_TX UART5 NODMA
PD2  UART5_RX UART5 NODMA

# UART6
PC6 USART6_TX USART6
PC7 USART6_RX USART6 NODMA

# UART7
PE8 UART7_TX UART7 NODMA
PE7 UART7_RX UART7 NODMA


# -------------------------------------------------
# ADC
# -------------------------------------------------

PC3 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC2 BATT_CURRENT_SENS ADC1 SCALE(1)
PC5 RSSI_ADC ADC1

define HAL_BATT_VOLT_PIN 13
define HAL_BATT_CURR_PIN 12
define BOARD_RSSI_ANA_PIN 15

# Initial values - must be calibrated later
define HAL_BATT_VOLT_SCALE 11.0
define HAL_BATT_CURR_SCALE 28.5
define HAL_BATT_MONITOR_DEFAULT 4


# -------------------------------------------------
# Motors
# Physical timer resources verified from Betaflight
# -------------------------------------------------

PB0  TIM3_CH3 TIM3 PWM(1) GPIO(50) BIDIR
PB1  TIM3_CH4 TIM3 PWM(2) GPIO(51)
PE9  TIM1_CH1 TIM1 PWM(3) GPIO(52)
PE11 TIM1_CH2 TIM1 PWM(4) GPIO(53) BIDIR

PC9  TIM8_CH4 TIM8 PWM(5) GPIO(54)
PA3  TIM5_CH4 TIM5 PWM(6) GPIO(55)
PB4  TIM3_CH1 TIM3 PWM(7) GPIO(56)
PB5  TIM3_CH2 TIM3 PWM(8) GPIO(57)


# -------------------------------------------------
# LED / Buzzer
# -------------------------------------------------

PA2 LED0 OUTPUT LOW GPIO(90)

PD15 BUZZER OUTPUT GPIO(80) LOW
define HAL_BUZZER_PIN 80


# -------------------------------------------------
# SPI devices
# -------------------------------------------------

SPIDEV dataflash SPI1 DEVID1 FLASH_CS MODE3 104*MHZ 104*MHZ

SPIDEV osd SPI2 DEVID2 AT7456E_CS MODE0 10*MHZ 10*MHZ

SPIDEV mpu6000 SPI4 DEVID4 MPU6000_CS MODE3 1*MHZ 4*MHZ

# -------------------------------------------------
# IMU
# Betaflight reports MPU6000 with CW270 orientation.
IMU Invensense SPI:mpu6000 ROTATION_YAW_270
# -------------------------------------------------

# Diagnostic multi-IMU probing.
# Rotations are copied from the known-working FlywooF745 definitions for now.
# We will determine the correct JHEMCU rotation after detecting the actual IMU.
define HAL_DEFAULT_INS_FAST_SAMPLE 1
DMA_PRIORITY ADC* USART6* TIM1* TIM3* SPI4* SPI1*
DMA_NOSHARE SPI4_RX
# -------------------------------------------------
# External flash logging
# -------------------------------------------------

define HAL_LOGGING_DATAFLASH_ENABLED 1


# -------------------------------------------------
# OSD
# -------------------------------------------------

define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font0.bin


# -------------------------------------------------
# Compass
# No onboard compass. Allow external I2C compass.
# -------------------------------------------------

define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 0


# -------------------------------------------------
# Barometer
# TEMPORARY: allow startup without a working barometer
# during custom-board bring-up.
# -------------------------------------------------

# BMP280 on physical I2C1 (logical bus 0), SDO high: 0x77.
BARO BMP280 I2C:0:0x77
define AP_BARO_BMP280_ENABLED 1

define HAL_BARO_ALLOW_INIT_NO_BARO 1

# Betaflight/X motor layout
define HAL_FRAME_TYPE_DEFAULT 12


# Reduce firmware size for F745
include ../include/minimize_fpv_osd.inc
