{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CAMERA_USE_SDRAM": "ON",
                "GPS_DIAGNOSTICS": "OFF",
                "GPS_BDS_TEST_PROFILE": "0",
                "GPS_MEASUREMENT_PERIOD_MS": "200",
                "RC7_GUIDED_TEST": "ON"
            }
        },
        {
            "name": "CameraSDRAM",
            "inherits": "Debug",
            "cacheVariables": {
                "CAMERA_USE_SDRAM": "ON"
            }
        },
        {
            "name": "DebugFlow",
            "inherits": "Debug",
            "cacheVariables": {
                "CAMERA_FLOW_BENCH": "ON",
                "CAMERA_FAST_MJPEG": "ON",
                "RC7_GUIDED_TEST": "OFF"
            }
        },
        {
            "name": "DebugFlowHw",
            "inherits": "DebugFlow",
            "cacheVariables": {
                "CAMERA_FLOW_HW_JPEG": "ON"
            }
        },
        {
            "name": "DebugRc7Guided",
            "inherits": "Debug"
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "CameraSDRAM",
            "configurePreset": "CameraSDRAM"
        },
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "DebugFlow",
            "configurePreset": "DebugFlow"
        },
        {
            "name": "DebugFlowHw",
            "configurePreset": "DebugFlowHw"
        },
        {
            "name": "DebugRc7Guided",
            "configurePreset": "DebugRc7Guided"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        }
    ]
}
